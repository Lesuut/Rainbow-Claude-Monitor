# Personal configuration: the account and directory layout of one machine.
# The template is config.example.json, and server.ps1 writes config.json itself
# on the first run when it is missing.
config.json

# Runtime state.
colors.json
.claims/

# Compiled console interop, rebuilt by poke.ps1 whenever it is missing.
.cache/

# Backups and editor litter.
*.bak
*.orig
*~
.vscode/
.idea/

# Logs.
*.log

# Windows / macOS.
Thumbs.db
desktop.ini
.DS_Store

# Finish-sound volume, written by the header slider.
sound.json

# Personal notification clip, picked per machine by the Stop hook.
sounds/
